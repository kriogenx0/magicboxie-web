[Unit]
Description=MagicBox personal media server
After=network.target

[Service]
Type=simple
User=magicbox
Group=magicbox
ExecStart=/opt/magicbox/bin/magicbox --config /etc/magicbox/config.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/magicbox /content
ProtectHome=true

[Install]
WantedBy=multi-user.target
