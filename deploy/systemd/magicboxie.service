# Installed by `make pi-install` (see Makefile's pi-* targets). If you
# override PI_CONTENT_DIR away from the /content default, update
# ReadWritePaths below to match -- it's not templated.
[Unit]
Description=MagicBoxie personal media server
After=network.target

[Service]
Type=simple
User=magicboxie
Group=magicboxie
ExecStart=/opt/magicboxie/bin/magicboxie --config /etc/magicboxie/config.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/magicboxie /content
ProtectHome=true

[Install]
WantedBy=multi-user.target
